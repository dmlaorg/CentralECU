package CentralEcu
{
    import Automotive
    import SysMLv2

    /*
     *
     * 											Basic building blocks
     * 										----------------------------
     */

    @AutomotiveElement
    @Part
    entity CentralEcuElement  
    {
        @Cardinality = {Max = 1;}
        @Type = {TypeRef = ASIL;} 
        new slot safetyLevel;

        @Cardinality = {Max = 1;}
        @Type = {TypeRef = Supplier;}
        new slot supplier;

        @Type = {TypeRef = Port;}
        @ContractSlot
        new slot ports;
    }

    /*
     *
     * 											CentralEcu components
     * 										------------------------------
     */

    entity CentralEcuComposition : CentralEcuElement {}

    entity CentralECU : CentralEcuComposition 
    {

        @Cardinality= {Min = 1;}
        @Type = {TypeRef = SoC;}
        new slot socs;
    }

    // AutomotiveElement as a Contract makes it easy to reintroduce at any point of a meta-chain
    @AutomotiveElement
    entity SharedMemoryPort : Port 
    {
        @Type = {TypeRef = MemoryRegion;}
        new slot memory;

        @Type = {TypeRef = MemoryRegion;}
        new slot accessedMemory;

        @Cardinality = {Max = 1;}
        @Type = {TypeRef = ASIL;} 
        new slot safetyLevel;

        @Cardinality = {Max = 1;}
        @Type = {TypeRef = Supplier;}
        new slot supplier;
    }

    @Interface
    entity SharedMemoryInterface 
    {
        @Cardinality = {Min = 2;}
        @Type = {TypeRef = SharedMemoryPort;}
        new slot ports;
    }

    entity SoC : CentralEcuComposition 
    {

        @Cardinality= {Min = 1;}
        @Type = {TypeRef = Core;}        
        new slot cores;

        @Cardinality= {Min = 1;}
        @Type = {TypeRef = EmbeddedSoftware;}        
        new slot softwares;

        @Cardinality= {Min = 1;}
        @Type = {TypeRef = MemoryModule;}        
        new slot memory;

        @Cardinality= {Min = 1;}
        @Type = {TypeRef = SharedMemoryPort;}        
        new slot ports;
    }

    entity Mcu : SoC
    {
        @Annotation_Omit
        slot ports = {};

        @Cardinality= {Max = 1;}
        slot cores;
    }

    entity Core : CentralEcuElement 
    {

        @Cardinality= {Max = 1;}
        @Type = {TypeRef = Real;}
        new slot frequencyHz;

        @Cardinality= {Max = 1;}
        @Type = {TypeRef = Bool;}
        new slot isLockstep;
    }

    entity EmbeddedSoftware : CentralEcuComposition {}
    entity PowerModule : CentralEcuElement {}
    entity MemoryModule : CentralEcuElement 
    {

        @Cardinality= {Min = 1; Max = -1;}
        @Type = {TypeRef = MemoryRegion;}
        new slot memoryRegion;
    }
    entity MemoryRegion  
    {

        @Cardinality= {Min = 1; Max = 1;}
        @Type = {TypeRef = Int;}
        new slot startAddress;

        @Cardinality= {Min = 1; Max = 1;}
        @Type = {TypeRef = Int;}
        new slot endAddress;
        
        @Cardinality= {Min = 1; Max = 1;}
        @Type = {TypeRef = Int;}
        new slot sizeKB;
    }

    /*
     *
     * 											    Example
     * 										---------------------
     */

    // Requirements are modeled as Contracts
    entity MinimumNumberOfMemoryBanks : AutomotiveRequirement 
    {
        slot id = "OTA-1-1";
        slot text = "The system shall have at least two separate non-volatile memory banks.";
        slot safetyLevel = ASIL_D;
        slot supplier =
        {
            isInternal = true;
            domain = Telematic;
            name = "InternalSupplier";
            id = "INT-001";
            contactinfo = "Budapest, Hungary";
        };

        @Cardinality = {Min = 2;}
        @Type = {TypeRef = MemoryModule;} 
        @ContractSlot
        new slot memory;
    }

    entity ThirdPartySupplier : Supplier { slot isInternal = false; }
    entity Renesas : ThirdPartySupplier { slot name = "Renesas"; }
    entity Arm : ThirdPartySupplier { slot name = "Arm"; }
    entity Tier1Supplier_B : ThirdPartySupplier { slot name = "Tier1Supplier_B"; }
    entity Tier1Supplier_A : ThirdPartySupplier { slot name = "Tier1Supplier_A"; }


    entity flash1 : MemoryModule {
        slot memoryRegion = 
        {
            sizeKB = 512.1;
            safetyLevel = ASIL_QM;
            supplier = Tier1Supplier_A;
        };
    }
    entity flash2 : MemoryModule {
        slot memoryRegion = 
        {
            sizeKB = 512;
            safetyLevel = ASIL_QM;
            supplier = Tier1Supplier_A;
        };
    }

    @MinimumNumberOfMemoryBanks
    entity SoC_A : SoC 
    {
        slot supplier = Renesas;
        slot cores = [cr7, ca57, ca57, ca53, ca53];
        slot safetyLevel = ASIL_D;

        @Cardinality = {Min = 2;}
        slot memory;
    }

    @MinimumNumberOfMemoryBanks
    entity SoC_B : SoC 
    {
        slot safetyLevel = ASIL_B;
    }

    entity cr7 : Core 
    {
        slot supplier = Arm;
        slot frequencyHz = 800000000.0;
        slot isLockstep = true;
        slot safetyLevel = ASIL_D;
    }

    entity ca57 : Core 
    {
        slot supplier = Arm;
        slot frequencyHz = 1900000000.0;
        slot isLockstep = false;
        slot safetyLevel = ASIL_B;
    }

    entity ca53 : Core 
    {
        slot supplier = Arm;
        slot frequencyHz = 1500000000;
        // validation logic catches type non-conformity: Int vs Real
        slot isLockstep = false;
        slot safetyLevel = ASIL_B;
    }

    entity ACC : EmbeddedSoftware 
    {
        slot safetyLevel = ASIL_B;
    }

    entity concreteACC : ACC 
    {
        slot supplier = Tier1Supplier_B;
    }

    entity brakeControl : EmbeddedSoftware 
    {
        slot safetyLevel = ASIL_D;
        slot supplier = Tier1Supplier_A;
    }

    entity swUpManager : EmbeddedSoftware 
    {
        slot safetyLevel = QM;
        slot supplier = Tier1Supplier_A;
    }

    operation Bool RuntimeExample() 
    {
        PrintEntity(flash1, false, 3);
        flash2 flash2instance = Create(flash2, false, "flash2instance");
        PrintEntity(flash2instance, false, 3);

        SharedMemoryPort portInstance = Create(SharedMemoryPort, false,"portInstance")
            .Set(SharedMemoryPort.safetyLevel, ASIL_B)
            ;

        SoC soCdeployment = Create(SoC_B, false, "soCdeployment")
            .Set(SoC.ports, portInstance)
            .AddValue(SoC.softwares, ACC)
            .AddValue(SoC.softwares, brakeControl)
            .AddValue(SoC.softwares, swUpManager)
            ;

        CentralECU domainController = Create(CentralECU, false, "domainController")
            .Set(CentralECU.supplier, "Tier1Supplier-A")
            .AddValue(CentralECU.socs, soCdeployment)
            ;

        ValidationError[] result = [];
        result = ValidateSelf(domainController);
        addAll(result, ValidateSelf(SoC_B));
        addAll(result, ValidateSelf(portInstance));

        if (count(result) == 0) {
            PrintLn("RuntimeExample validation PASSED.", "green");
            return true;
        }

        foreach (ValidationError error in result) {
            String errorMessage= "RuntimeExample validation error 
                [${error.Get(ValidationError.ErrorCode)}] 
                ('${error.Get(ValidationError.Message)}').\n";
            PrintError(errorMessage);
        }
        return false;
    }
}