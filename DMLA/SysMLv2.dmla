package SysMLv2
{
    /*
     *
     * 											Systems Modeling Language v2 building blocks
     * 										----------------------------------------------------
     */

    // A subset of SysMLv2 concepts offered as contracts, with focus on Software Architecture Modeling

    entity Part : Contract
    {
        @Type = {TypeRef = Port;}
        @ContractSlot
        new slot ports;

        override operation ValidationError[] Check(Base definedFor, Object appliesOn, Base? ContainerContext)
        {
            //String code = GeneratePartCode(appliesOn, 0, null);
            //PrintLn(code);
            return [];
        }
    }

    entity Port
    {
        @Cardinality = {Min = 1; Max = 1;}
        @Type = {TypeRef = Interface;}
        new slot interface;

        @Cardinality = {Min = 1; Max = 1;}
        @Type = {TypeRef = PortDirection;}
        new slot direction; // Direction can be "in", "out", "inout"
    }
    
    entity PortDirection { 
        @Cardinality = {Min = 1; Max = 1;}
        @Type = {TypeRef = Int;}    // In  Out  InOut
        new slot value;             //  0   +1   +2
    }
    entity In : PortDirection   {@ConstantValue slot value = 0;}
    entity Out : PortDirection  {@ConstantValue slot value = 1;}
    entity InOut : PortDirection{@Constantvalue slot value = 2;}

    // Concept for part connection
    entity Interface : Part
    {
        @Cardinality = { Min = 2;}
        new slot ports;

        new slot payload;
    }
    
    // Concept for runtime block connection
    operation Bool Connect(Base from, Base to, Base interfaceInstance)
    {
        Base[] blocks = [from, to, interfaceInstance];
        foreach (Base element in blocks)
        {
            if (!element.HasAnnotation(Part, true) && !element.HasAnnotation(Interface, true))
            {
                PrintLn("Error: ${GetID(element)} is not a Part, or Interface and cannot be connected.");
                return false;
            }
        }
        foreach (Port portInstance in getSlotValue(from.GetAttributeByMeta((from as Part).ports))) 
        {
            if ((portInstance.direction is Out) && portInstance.GetAttributeByMeta(portInstance.interface.Type).GetTypeRef().isTransitiveInstance(portInstance.interface.Type,true))
            {
                portInstance.Set(Port.interface,interfaceInstance);
                interfaceInstance.AddValue(Interface.ports,portInstance);
                PrintLn("Connected ${GetID(from)} to ${GetID(interfaceInstance)}");
            }
            else return false;
        }
        foreach (Port portInstance in getSlotValue(to.GetAttributeByMeta((to as Part).ports)))
        {
            if ((portInstance.direction is In) && portInstance.GetAttributeByMeta(portInstance.interface.Type).GetTypeRef().isTransitiveInstance(portInstance.interface.Type,true))
            {
                portInstance.Set(Port.interface,interfaceInstance);
                interfaceInstance.AddValue(Interface.ports,portInstance);
                PrintLn("Connected ${GetID(to)} to ${GetID(interfaceInstance)}");
            }
            else return false;
        }
        return true;
    }

    // Concept for M2T transformation
    operation String GenerateCode(Base root, Bool skipIntermediateInstances = true)
    {
        String output = "";
        
        foreach (Base instance in getInstances(root, true))
        {
            if (skipIntermediateInstances && !instance.HasAnnotation(Final,false))
            {
                continue; // skip intermediate instances
            }
            if (instance.HasAnnotation(Interface, true))
            {
                output = "${output}${GenerateInterfaceCode(instance, 0)}\n\n";
            }
            else if (instance.HasAnnotation(Part, true))
            {
                output = "${output}${GeneratePartCode(instance, 0, null)}\n\n";
            }
            else
            {
                output = output + "// Generation for ${GetLocalID(instance)} is undefined.\n";
            }
        }
        
        return output;
    }

    operation String GeneratePartCode(Base part, Int indentLevel, Base? partType = null)
    {
        String code = "";
        String indent = "";
        Int i = 0;
        while (i < indentLevel)
        {
            indent = indent + "\t";
            i = i + 1;
        }

        if (partType == null) 
        {
            // Must be a composition, not a slot
            partType = part.GetAttributeByMeta(Part, true, false);
        }
        code = code + "${indent}part ${GetLocalID(part)} : ${GetLocalID(partType)}\n";
        code = code + "${indent}{\n";

        // Generate nested parts from all slots
        Base[] allSlots = part.GetAllSlots();
        //code = code + "${indent}\t// DEBUG: Total slots: ${count(allSlots)}\n";
        
        foreach (Base attrib in allSlots)
        {
            //code = code + "${indent}\t// DEBUG: Processing attribute: ${GetID(attrib)}\n";
            Object? slotValue = getSlotValue(attrib);
            if (slotValue is Base && slotValue.HasAnnotation(Part, true))
            {
                Base? slotType = slotValue.GetAttributeByMeta(Part, true, false);
                //code = code + "${indent}\t// DEBUG: Attribute value ${GetID(slotValue)} has Part annotation - ${GetLocalID(slotType)}\n";
                code = code + GeneratePartCode(slotValue, indentLevel + 1, slotType);
            }
            else
            {
                if (slotValue != null) 
                {
                    String slotValuePrint = "";
                    if (slotValue is Entity || (slotValue is Object && !(IsPrimitiveLiteral(slotValue))))
                    {
                        slotValuePrint = "${GetLocalID(slotValue)}";
                    }
                    else
                    {
                        slotValuePrint = "${slotValue}";
                    }
                    code = code + "${indent}\t:>> ${GetLocalID(attrib)} = ${slotValuePrint};\n";
                }
            }
        }
        code = code + "${indent}}\n";
        return code;
    }

    operation String GenerateInterfaceCode(Base interface, Int indentLevel)
    {
        String code = "";
        String indent = "";
        Int i = 0;
        while (i < indentLevel)
        {
            indent = indent + "\t";
            i = i + 1;
        }

        // Generate ports from ports slot
        Base[] ports = [];
        Base[] allSlots = interface.GetAllSlots();
        code = code + "${indent}// DEBUG: Total slots of ${GetLocalID(interface)} interface: ${count(allSlots)}\n";
        
        foreach (Base attrib in allSlots)
        {
            code = code + "${indent}\t// DEBUG: Processing attribute: ${GetID(attrib)}\n";
            Object? slotValue = getSlotValue(attrib);
            if (slotValue is Port)
            {
                ports.add(slotValue);
            }
            else if (slotValue is Port[])
            {
                ports.addAll(slotValue);
            }
        }
        code = code + "${indent}// DEBUG: Interface has ${count(ports)} ports.\n";
        foreach (Port portA in ports)
        {
            foreach (Port portB in ports)
            {
                if (portA == portB) continue;
                if (getSlotValue(portA.direction) is Out && getSlotValue(portB.direction) is In)
                {
                    code = code + "interface ${GetLocalID(portA)} to ${GetLocalID(portB)};\n";
                }
                else if (getSlotValue(portA.direction) is In && getSlotValue(portB.direction) is Out)
                {
                    code = code + "interface ${GetLocalID(portA)} to ${GetLocalID(portB)};\n";
                }
                else
                {
                    code = code + "//No match from ${GetLocalID(portA)} to ${GetLocalID(portB)};\n";
                }
            }
        }
        return code;
    }
}