package TinySWA
{
    import SysMLv2
    import AUTOSAR

    /*
     * Tiny Software Architecture - a minimal example for DMLA to SysMLv2 translation
     * Demonstrates:
     * - Part definitions with typed ports
     * - Port directions (in/out)
     * - Interface declarations  
     * - SysMLv2 code generation output
     */

    entity base {}

    // ===== Port prototypes =====
    entity SensorDataInput : Port
    {
        slot direction = In;
        slot interface = SensorDataInterface;
    }

    entity SensorDataOutput : Port
    {
        slot direction = Out;
        slot interface = SensorDataInterface;
    }

    // ===== Software Component definitions =====

    @OsTask
    entity HigherPrioTask
    {
        @Cardinality = {Min = 1; Max = 1;}
        new slot osTaskPeriod = 10;
        
        @Type = {TypeRef = Port;}
        new slot ports;
    }

    entity task10ms_sr : SensorDataOutput {}
    
    entity task10ms : HigherPrioTask
    {
        @Type = {TypeRef = Port;}
        new slot task10mPort : ports = task10ms_sr;
    }

    @ApplicationSwC
    entity SensorComponent : base
    {
        @Type = {TypeRef = Port;}
        new slot ports;
    }

    entity aswc1 : SensorComponent 
    {
        new slot tasks = task10ms;
    }

    @OsTask
    entity LowerPrioTask
    {
        @Cardinality = {Min = 1; Max = 1;}
        new slot osTaskPeriod = 20;
        
        @Type = {TypeRef = Port;}
        new slot ports = SensorDataInput;
    }
    
    entity task20ms_sr : SensorDataInput {}

    entity task20ms : LowerPrioTask
    {
        @Type = {TypeRef = Port;}
        new slot task20mPort : ports = task20ms_sr;
    }

    @ApplicationSwC
    entity ActuatorComponent : base
    {
        @Type = {TypeRef = Port;}
        new slot ports;
    }

    entity aswc2 : ActuatorComponent 
    {
        new slot tasks = task20ms;
    }

    @CompositionSwC
    @FinalInstance
    entity root : base
    {
        @Type = {TypeRef = Port;}
        slot ports;

        new slot aswc1 = aswc1;
        new slot aswc2 = aswc2;
    }

    entity rootAfterFinalInstance : root {}

    // ===== Interface definition =====
    @SenderReceiverIF
    entity SensorDataInterfaceProto : base
    {
        @Cardinality = { Min = 2;}
        @Type = {TypeRef = Port;}
        new slot ports;

        new slot payload = 2025;
    }

    @FinalInstance
    entity SensorDataInterface : SensorDataInterfaceProto
    {
        @Type = {TypeRef = Port;}
        slot portIn : ports = task20ms_sr;
        
        @Type = {TypeRef = Port;}
        slot portOut : ports = task10ms_sr;

        slot payload = 2026;
    }

    // ===== Code Generation Demo Operation =====
    operation void SysMLv2CodeGenerationDemo()
    {
        PrintLn("");
        PrintLn("========================================", "red");
        PrintLn("   SysMLv2 Code Generation Demo START   ", "red");
        PrintLn("========================================", "red");
        PrintLn("");

        String code = GenerateCode(base);
        PrintLn(code);

        PrintLn("");
        PrintLn("========================================", "green");
        PrintLn("    SysMLv2 Code Generation Demo END    ", "green");
        PrintLn("========================================", "green");
    }
}

