package TinySWA
{
    import SysMLv2
    import AUTOSAR
    import DMLAProfilingLib

    /*
     * Tiny Software Architecture - a minimal example for DMLA to SysMLv2 translation
     * Demonstrates:
     * - Part definitions with typed ports
     * - Port directions (in/out)
     * - Interface declarations  
     * - SysMLv2 code generation output
     */

    entity base {}

    // ===== Port prototypes =====
    entity SensorDataPort : Port
    {
        @Type = {TypeRef = SensorDataInterfaceProto;}
        slot interface;
    }
    entity SensorDataInput : Port
    {
        slot direction = In;
        slot interface = SensorDataInterface;
    }

    entity SensorDataOutput : Port
    {
        slot direction = Out;
        slot interface = SensorDataInterface;
    }

    // ===== Software Component definitions =====

    @OsTask
    entity HigherPrioTask
    {
        @Cardinality = {Min = 1; Max = 1;}
        new slot osTaskPeriod = 10;
    }

    @ApplicationSwC
    entity SensorComponent : base
    {
        @Type = {TypeRef = Port;}
        @Cardinality = {Min = 1; Max = 1;}
        new slot ports = SensorDataOutput;
    }

    entity aswc1 : SensorComponent 
    {
        new slot tasks = HigherPrioTask;
    }

    @OsTask
    entity LowerPrioTask
    {
        @Cardinality = {Min = 1; Max = 1;}
        new slot osTaskPeriod = 20;
    }

    @ApplicationSwC
    entity ActuatorComponent : base
    {
        @Type = {TypeRef = Port;}
        @Cardinality = {Min = 1; Max = 1;}
        new slot ports = SensorDataInput;
    }

    entity aswc2 : ActuatorComponent 
    {
        new slot tasks = LowerPrioTask;
    }

    @CompositionSwC
    @Final
    entity root : base
    {
        @Type = {TypeRef = Port;}
        slot ports;

        new slot aswc1 = aswc1;
        new slot aswc2 = aswc2;
    }

    @Final
    entity rootAfterFinal : base {}

    // ===== Interface definition =====
    @SenderReceiverIF
    entity SensorDataInterfaceProto : base
    {
        @Cardinality = { Min = 2;}
        @Type = {TypeRef = SensorDataPort;}
        new slot ports;

        new slot payload = 2025;
    }

    @Final
    entity SensorDataInterface : SensorDataInterfaceProto
    {
        slot ports: ports = [aswc1.ports, aswc2.ports];

        slot payload = 2026;
    }

    // ===== Code Generation Demo Operation =====
    operation void SysMLv2CodeGenerationDemo()
    {
        PrintLn("");
        PrintLn("========================================", "red");
        PrintLn("   SysMLv2 Code Generation Demo START   ", "red");
        PrintLn("========================================", "red");
        PrintLn("");

        Int start = getTick();
        String code = GenerateCode(base);
        Int end = getTick();
        PrintLn(code);
        PrintLn("Code generation took ${end - start} ticks.");

        Int start = getTick();
        ValidateInstances(base);
        Int end = getTick();
        PrintLn(code);
        PrintLn("Code validation took ${end - start} ticks.");
        
        Int start = getTick();
        ValidateInstances(base);
        String code = GenerateCode(base);
        Int end = getTick();
        PrintLn(code);
        PrintLn("Sequential validation + code generation took ${end - start} ticks.");
        
        PrintLn("");
        PrintLn("========================================", "green");
        PrintLn("    SysMLv2 Code Generation Demo END    ", "green");
        PrintLn("========================================", "green");
    }
}

